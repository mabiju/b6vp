@* Program no 4 
@page
<h1>Result Finder:</h1>
@{
    int marks = 37;
}
@if (marks >= 80)
{
    <p>First division with distinction.</p>
}
else if (marks >= 60)
{
    <p>First division</p>
}
else if (marks >= 45)
{
    <p>Second division</p>
}
else if (marks >= 32)
{
    <p>Third division</p>
}
else
{
    <p>Fail</p>
}
*@

