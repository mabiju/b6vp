@* Program no 12 *@
@page
@{
    string[] students = { "Ram", "Sita", "Hari", "Gita" };
    int[] marks = { 80, 35, 65, 45 };
}
<h1>Student Result:</h1>
@for (int i = 0; i < students.Length; i++)
{
    <p>
        Marks of @students[i] is @marks[i], and result is 

        @if (marks[i] >= 40)
        {
            <b> Pass</b>
        }
        else
        {
            <b> Fail</b>
        }
    </p>
}
